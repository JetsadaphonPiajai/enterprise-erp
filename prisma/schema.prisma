datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. User & Access Control (RBAC)
// -------------------------------------------------------------
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  role         String      @default("ADMIN") // ADMIN, PURCHASER, SALES, WAREHOUSE, ACCOUNTANT
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  stockMoves   StockMove[]
}

// -------------------------------------------------------------
// 2. Master Data
// -------------------------------------------------------------
model UnitOfMeasure {
  id        String    @id @default(uuid())
  code      String    @unique // e.g. "PCS", "BOX", "SET", "KG"
  nameTh    String
  nameEn    String?
  products  Product[]
}

model ProductCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  products    Product[]
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  barcode        String?         @unique
  name           String
  description    String?
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  uomId          String
  uom            UnitOfMeasure   @relation(fields: [uomId], references: [id])
  costPrice      Float           @default(0) // ต้นทุนมาตรฐาน
  sellingPrice   Float           @default(0) // ราคาขายปลีก/ส่ง
  minStockAlert  Float           @default(0) // จุดเตือนสั่งซื้อซ้ำ
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stockQuants        StockQuant[]
  stockMoves         StockMove[]
  poItems            PurchaseOrderItem[]
  grnItems           GoodsReceiptItem[]
  soItems            SalesOrderItem[]
  doItems            DeliveryOrderItem[]
}

model Partner {
  id             String         @id @default(uuid())
  code           String         @unique // e.g. "CUST-0001", "VEND-0001"
  name           String
  partnerType    String         // "CUSTOMER", "VENDOR", "BOTH"
  taxId          String?        // เลขประจำตัวผู้เสียภาษี 13 หลัก
  branchCode     String         @default("00000") // 00000 = สนง.ใหญ่
  phone          String?
  email          String?
  address        String?
  creditTermDays Int            @default(30)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  invoices       TaxInvoice[]
}

// -------------------------------------------------------------
// 3. Warehouse & Inventory Ledger
// -------------------------------------------------------------
model Warehouse {
  id          String          @id @default(uuid())
  code        String          @unique // e.g. "WH-MAIN", "WH-BRANCH1"
  name        String
  address     String?
  isActive    Boolean         @default(true)
  locations   StockLocation[]
  receipts    GoodsReceipt[]
  deliveries  DeliveryOrder[]
}

model StockLocation {
  id          String       @id @default(uuid())
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String       // e.g. "A-01-01"
  name        String
  isInternal  Boolean      @default(true)

  stockQuants StockQuant[]
  movesFrom   StockMove[]  @relation("MovesFrom")
  movesTo     StockMove[]  @relation("MovesTo")
  grnItems    GoodsReceiptItem[]
  doItems     DeliveryOrderItem[]

  @@unique([warehouseId, code])
}

// Stock Balance Cache (On-hand & Reserved)
model StockQuant {
  id          String        @id @default(uuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  String
  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity    Float         @default(0) // ยอดคงเหลือจริง
  reservedQty Float         @default(0) // จองไว้รอแพ็คส่ง

  @@unique([productId, locationId])
}

// Immutable Stock Movement Ledger
model StockMove {
  id               String         @id @default(uuid())
  moveNumber       String         @unique // e.g. "SM-202610-0001"
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  sourceLocationId String?
  sourceLocation   StockLocation? @relation("MovesFrom", fields: [sourceLocationId], references: [id])
  destLocationId   String?
  destLocation     StockLocation? @relation("MovesTo", fields: [destLocationId], references: [id])
  quantity         Float
  unitCost         Float          @default(0)
  moveType         String         // "RECEIPT", "DELIVERY", "TRANSFER", "ADJUSTMENT"
  referenceDoc     String?        // e.g. "PO-202610-0001", "DO-202610-0001"
  note             String?
  createdAt        DateTime       @default(now())
  createdById      String?
  createdBy        User?          @relation(fields: [createdById], references: [id])
}

// -------------------------------------------------------------
// 4. Purchasing Module
// -------------------------------------------------------------
model PurchaseOrder {
  id             String              @id @default(uuid())
  orderNumber    String              @unique // PO-202610-0001
  vendorId       String
  vendor         Partner             @relation(fields: [vendorId], references: [id])
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  status         String              @default("DRAFT") // DRAFT, CONFIRMED, PARTIAL, COMPLETED, CANCELLED
  subtotal       Float               @default(0)
  taxRate        Float               @default(7)
  taxAmount      Float               @default(0)
  totalAmount    Float               @default(0)
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          PurchaseOrderItem[]
  receipts       GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Float
  unitPrice       Float
  amount          Float
  receivedQty     Float         @default(0)
}

model GoodsReceipt {
  id            String             @id @default(uuid())
  receiptNumber String             @unique // GRN-202610-0001
  purchaseOrderId String?
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  warehouseId   String
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  receiptDate   DateTime           @default(now())
  status        String             @default("COMPLETED")
  note          String?
  createdAt     DateTime           @default(now())

  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String        @id @default(uuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  locationId     String
  location       StockLocation @relation(fields: [locationId], references: [id])
  quantity       Float
}

// -------------------------------------------------------------
// 5. Sales Module
// -------------------------------------------------------------
model SalesOrder {
  id             String           @id @default(uuid())
  orderNumber    String           @unique // SO-202610-0001
  customerId     String
  customer       Partner          @relation(fields: [customerId], references: [id])
  orderDate      DateTime         @default(now())
  dueDate        DateTime?
  status         String           @default("DRAFT") // DRAFT, CONFIRMED, DELIVERED, INVOICED, CANCELLED
  subtotal       Float            @default(0)
  taxRate        Float            @default(7)
  taxAmount      Float            @default(0)
  totalAmount    Float            @default(0)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          SalesOrderItem[]
  deliveries     DeliveryOrder[]
  invoices       TaxInvoice[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Float
  unitPrice    Float
  amount       Float
  deliveredQty Float      @default(0)
}

model DeliveryOrder {
  id             String              @id @default(uuid())
  deliveryNumber String              @unique // DO-202610-0001
  salesOrderId   String?
  salesOrder     SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  warehouseId    String
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  deliveryDate   DateTime            @default(now())
  status         String              @default("SHIPPED")
  trackingNo     String?
  note           String?
  createdAt      DateTime            @default(now())

  items          DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id              String        @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  locationId      String
  location        StockLocation @relation(fields: [locationId], references: [id])
  quantity        Float
}

model TaxInvoice {
  id            String      @id @default(uuid())
  invoiceNumber String      @unique // INV-202610-0001
  salesOrderId  String?
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customerId    String
  customer      Partner     @relation(fields: [customerId], references: [id])
  invoiceDate   DateTime    @default(now())
  dueDate       DateTime?
  subtotal      Float
  taxRate       Float       @default(7)
  taxAmount     Float
  totalAmount   Float
  status        String      @default("UNPAID") // UNPAID, PAID, CANCELLED
  paymentMethod String?     // TRANSFER, CASH, CHEQUE
  paidAt        DateTime?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// -------------------------------------------------------------
// 6. Document Sequencing Engine
// -------------------------------------------------------------
model DocumentSequence {
  id           String   @id @default(uuid())
  docType      String   @unique // "PO", "GRN", "SO", "DO", "INV", "SM"
  prefix       String   // e.g. "INV"
  currentYear  Int      // 2026
  currentMonth Int      // 10
  currentSeq   Int      @default(0)
  updatedAt    DateTime @updatedAt
}
